# Copy to .env locally, or /etc/smj-eje/.env on the VPS. Never commit real secrets.
APP_PASSWORD=
FLASK_SECRET_KEY=
APP_ENV=production
ENV_FILE=/etc/smj-eje/.env
DB_PATH=/var/lib/smj-eje/reports.db
BACKUP_DIR=/var/lib/smj-eje/backups
TZ=Europe/Moscow
DATA_START_DATE=2026-09-01
SYNC_MUTABLE_DAYS=7
SESSION_DAYS=7
STALE_AFTER_MINUTES=120

SMARTJ_USERNAME=
SMARTJ_PASSWORD=
# The existing Smart-J source uses HTTP. Prefer HTTPS if supported by the source.
SMARTJ_BASE_URL=http://my.smart-j.ru
# Explicit opt-in for the existing HTTP source; this does not affect HTTPS on your subdomain.
SMARTJ_ALLOW_HTTP=true
SMARTJ_REPORT_PREFIX=/r1869~plan/kt-plan-report
SMARTJ_REQUEST_PAUSE=2
SYNC_MAX_REMOVAL_RATIO=0.5
