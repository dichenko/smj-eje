[Unit]
Description=Consistent Smart-J database backup

[Service]
Type=oneshot
User=smj
Group=smj
WorkingDirectory=/opt/smj-eje
Environment=ENV_FILE=/etc/smj-eje/.env
ExecStart=/opt/smj-eje/.venv/bin/smj backup
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/smj-eje
MemoryMax=256M
