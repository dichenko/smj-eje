[Unit]
Description=Smart-J private reports
After=network.target

[Service]
Type=simple
User=smj
Group=smj
WorkingDirectory=/opt/smj-eje
EnvironmentFile=/etc/smj-eje/.env
Environment=APP_ENV=production
Environment=ENV_FILE=/etc/smj-eje/.env
ExecStart=/opt/smj-eje/.venv/bin/gunicorn --bind 127.0.0.1:8081 --workers 1 --threads 2 --timeout 60 --access-logfile - --error-logfile - wsgi:app
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/smj-eje
MemoryMax=384M

[Install]
WantedBy=multi-user.target
